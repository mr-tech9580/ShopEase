<% layout('layouts/boilerplate') %>

<%- include('../partials/navbar') %>

<%- include('../partials/flash') %>

<section class="luxury-form-section">

    <div class="container">

        <div class="luxury-form-card">

            <div class="text-center mb-5">

                <span class="section-tag">

                    ✦ Seller Panel

                </span>

                <h1 class="luxury-title">

                    Add New Luxury Bag

                </h1>

                <p class="text-muted">

                    Showcase your premium handbag collection by adding a new product.

                </p>

            </div>

            <form
                action="/products"
                method="POST"
                class="needs-validation"
                novalidate>

                <div class="mb-4">

                    <label class="form-label">

                        Product Name

                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="name"
                        id="name"
                        placeholder="Luxury Leather Tote"
                        required>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Price

                    </label>

                    <input
                        type="number"
                        class="form-control"
                        name="price"
                        id="price"
                        placeholder="4999"
                        step="0.01"
                        required>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Description

                    </label>

                    <textarea
                        class="form-control"
                        name="desc"
                        id="description"
                        rows="6"
                        placeholder="Describe your premium handbag..."
                    ></textarea>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Image URL

                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="img"
                        id="img"
                        placeholder="https://..."
                        required>

                </div>

                <button
                    class="btn hero-primary w-100"
                    type="submit">

                    Add Product

                </button>

            </form>

        </div>

    </div>

</section>

<script>

(() => {

'use strict'

const forms = document.querySelectorAll('.needs-validation')

Array.from(forms).forEach(form => {

form.addEventListener('submit', event => {

if (!form.checkValidity()) {

event.preventDefault()

event.stopPropagation()

}

form.classList.add('was-validated')

}, false)

})

})()

</script>